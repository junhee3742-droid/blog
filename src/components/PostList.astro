---
import type { Lang } from '../config';
import { CATEGORY_LABEL, UI, formatDate } from '../i18n';
import { postUrl, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  lang: Lang;
  showCategory?: boolean;
}

const { posts, lang, showCategory = true } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{UI[lang].noPosts}</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="title" href={postUrl(post)}>
            {post.data.title}
          </a>
          <p>{post.data.description}</p>
          <div class="meta">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
            {showCategory && <span class="badge">{CATEGORY_LABEL[lang][post.data.category]}</span>}
          </div>
        </li>
      ))}
    </ul>
  )
}
