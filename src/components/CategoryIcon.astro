---
// 카테고리 아이콘. science = 뉴런, projects = 터미널 창.
import type { Category } from '../config';

interface Props {
  category: Category;
  size?: number;
}

const { category, size = 20 } = Astro.props;
---

<svg
  class="cat-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    category === 'science' ? (
      <path d="M9 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6zM6.9 9.9L3.5 6.5M6.9 14.1L3.5 17.5M8.5 9L7.5 4M12 12h8.5M18 12l2.5-2.5M18 12l2.5 2.5" />
    ) : (
      <path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM7 10l2.5 2L7 14M12 15h4" />
    )
  }
</svg>
