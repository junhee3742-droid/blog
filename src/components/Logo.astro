---
// Vibe Lab Notes 로고 마크: 삼각 플라스크 + 안에 흔들리는 물결(vibe).
// 선 색은 currentColor 라서 글자색을 따라가요 (라이트/다크 모드 모두 OK).
interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M12 4.5h8M13.2 4.5v7.6L6.6 24.6a2 2 0 0 0 1.8 2.9h15.2a2 2 0 0 0 1.8-2.9l-6.6-12.5V4.5"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    class="logo-wave"
    d="M9.6 19.5q1.6-1.7 3.2 0t3.2 0t3.2 0t3.2 0"
    stroke="#1f4f8a"
    stroke-width="2"
    stroke-linecap="round"
  />
  <circle class="logo-bubble" cx="16.4" cy="15" r="1.1" fill="#1f4f8a" />
</svg>
