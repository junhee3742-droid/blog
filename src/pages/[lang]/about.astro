---
import Base from '../../layouts/Base.astro';
import { LANGS, type Lang } from '../../config';
import { UI, otherLang } from '../../i18n';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={UI[lang].about} alternateUrl={`/${otherLang(lang)}/about/`}>
  <section class="intro prose about">
    <div class="about-head">
      <h1>{UI[lang].about}</h1>
      <img class="mascot" src="/mascot.svg" alt="" width="72" height="72" />
    </div>
    {
      lang === 'ko' ? (
        <>
          <p>신경과학 박사과정을 준비하며, 논문을 읽고 AI로 연구·생산성 도구를 직접 만드는 과정을 기록합니다.</p>
          <p>이 블로그에서 다루는 것:</p>
          <ul>
            <li>과학 · 연구 소식: 논문 요약, 노벨상, 신약 임상시험 결과 같은 과학 이슈</li>
            <li>개발 · 부업: 바이브 코딩으로 만든 논문 수집기, 글쓰기 자동화 워크플로우, 앱 등</li>
          </ul>
          <h2>마스코트 뉴로니</h2>
          <p>
            제목 옆의 친구는 블로그 마스코트 <strong>뉴로니</strong>예요. 신경세포(뉴런)를 닮아서, 머리 위 수상돌기로 소식을
            듣고 꼬리(축삭)로 전해 줘요. 글 곳곳에서 스티커로도 만날 수 있어요.
          </p>
          <p><a href="/ko/posts/meet-neuroni/">뉴로니 자세히 알아보기 →</a></p>
        </>
      ) : (
        <>
          <p>
            Notes from a neuroscience grad student: reading papers and building research and productivity tools with AI.
          </p>
          <p>What you will find here:</p>
          <ul>
            <li>Science &amp; Research: paper summaries, Nobel prizes, clinical trial results and other science news</li>
            <li>Projects: a paper collector, writing automation workflows, apps and more, built with AI</li>
          </ul>
          <h2>Our mascot, Neuroni</h2>
          <p>
            The little friend next to the title is <strong>Neuroni</strong>, the blog mascot. Built like a neuron, it picks up news with
            its dendrites and passes it on with its axon tail. You will find Neuroni as stickers throughout the posts.
          </p>
          <p><a href="/en/posts/meet-neuroni/">Learn more about Neuroni →</a></p>
        </>
      )
    }
  </section>
</Base>
