---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import type { Lang } from '../../../config';
import { CATEGORY_LABEL, UI, formatDate, noteNumber, noteOpenLabel, stampDate } from '../../../i18n';
import { findTranslation, postSlug, postUrl, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  // 노트 번호: 언어별로 오래된 글부터 1, 2, 3...
  const byDate = [...posts].sort(
    (a, b) => a.data.date.valueOf() - b.data.date.valueOf() || a.id.localeCompare(b.id),
  );
  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: postSlug(post) },
    props: {
      post,
      noteNo: byDate.filter((p) => p.data.lang === post.data.lang).findIndex((p) => p.id === post.id) + 1,
    },
  }));
}

interface Props {
  post: Post;
  noteNo: number;
}

const { post, noteNo } = Astro.props;
const lang = post.data.lang as Lang;
const { Content } = await render(post);
const translation = await findTranslation(post);
const fullTitle = post.data.subtitle ? `${post.data.title} – ${post.data.subtitle}` : post.data.title;
---

<Base
  lang={lang}
  title={fullTitle}
  description={post.data.description}
  alternateUrl={translation ? postUrl(translation) : undefined}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
>
  <article class={`post cat-${post.data.category}`}>
    {
      post.data.cover && (
        <figure class="cover">
          <img src={post.data.cover} alt={post.data.coverAlt ?? ''} />
        </figure>
      )
    }
    <header class="post-header">
      <div class="meta">
        <a class="badge" href={`/${lang}/${post.data.category}/`}>
          {CATEGORY_LABEL[lang][post.data.category]}
        </a>
        <time class="stamp" datetime={post.data.date.toISOString()} title={formatDate(post.data.date, lang)}>
          {stampDate(post.data.date)}
        </time>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
    </header>

    <p class="note-open">
      <img src="/stickers/happy.svg" alt="" width="44" height="44" />
      <span>
        {noteOpenLabel(noteNo, lang)} · <span class="stamp">{stampDate(post.data.date)}</span>
      </span>
    </p>

    <div class="prose">
      <Content />
    </div>

    <aside class="note-close" aria-label={noteNumber(noteNo)}>
      <img src="/mascot.svg" alt="" width="72" height="72" loading="lazy" />
      <div>
        <p class="note-close-main">{UI[lang].noteClose}</p>
        <p class="note-close-sub">{UI[lang].noteThanks}</p>
        <p class="note-close-sub"><a href={`/${lang}/subscribe/`}>{UI[lang].subscribeCta}</a></p>
      </div>
    </aside>

    {
      post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )
    }

    <Comments postId={post.id} lang={lang} />

    <a class="back" href={`/${lang}/`}>{UI[lang].backToList}</a>
  </article>
</Base>
