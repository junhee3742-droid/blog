---
// 첫 주소(/)로 들어오면 한국어 홈으로 보내요.
import { SITE_VERIFICATION } from '../config';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/ko/" />
    <link rel="canonical" href="/ko/" />
    {SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
    {SITE_VERIFICATION.naver && <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />}
    <title>Redirecting…</title>
  </head>
  <body>
    <a href="/ko/">/ko/</a>
  </body>
</html>
