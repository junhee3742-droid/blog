---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { CATEGORIES, SITE, SITE_URL, type Lang } from '../config';
import { CATEGORY_LABEL, UI, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 언어 전환 버튼이 갈 주소. 없으면 다른 언어의 홈으로 가요. */
  alternateUrl?: string;
  /** 공유 미리보기(og:image)에 쓸 이미지 주소. 예: '/images/posts/foo.png' */
  image?: string;
  imageAlt?: string;
}

const { lang, title, description, alternateUrl, image, imageAlt } = Astro.props;
const siteTitle = SITE.title[lang];
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const pageDesc = description ?? SITE.description[lang];
const other = otherLang(lang);
const switchUrl = alternateUrl ?? `/${other}/`;
const path = Astro.url.pathname;
const t = UI[lang];
const ogImage = image ? new URL(image, Astro.site ?? SITE_URL).href : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {ogImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a24" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" hreflang={other} href={switchUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+KR:wght@600;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`/${lang}/`}>
          <Logo size={30} />
          <span class="brand-name">{siteTitle}</span>
        </a>
        <nav class="site-nav">
          {
            CATEGORIES.map((cat) => {
              const href = `/${lang}/${cat}/`;
              return (
                <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                  {CATEGORY_LABEL[lang][cat]}
                </a>
              );
            })
          }
          <a href={`/${lang}/about/`} aria-current={path.startsWith(`/${lang}/about`) ? 'page' : undefined}>
            {t.about}
          </a>
          <a class="lang-switch" href={switchUrl} hreflang={other}>{t.otherLang}</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <Logo size={18} />
        <span>© {new Date().getFullYear()} {siteTitle}</span>
      </div>
    </footer>
  </body>
</html>
