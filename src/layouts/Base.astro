---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { CATEGORIES, SITE, SITE_URL, SITE_VERIFICATION, type Lang } from '../config';
import { CATEGORY_LABEL, UI, otherLang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** 페이지 종류: 일반 페이지는 website, 블로그 글은 article */
  type?: 'website' | 'article';
  /** 언어 전환 버튼이 갈 주소. 없으면 다른 언어의 홈으로 가요. */
  alternateUrl?: string;
  /** 공유 미리보기(og:image)에 쓸 이미지 주소. 예: '/images/posts/foo.png' */
  image?: string;
  imageAlt?: string;
  /** 글 발행일 (article 메타 및 구조화 데이터용) */
  publishedTime?: Date;
  /** 글 카테고리 이름 (article 메타용) */
  categoryLabel?: string;
  /** 글 태그 목록 */
  tags?: string[];
}

const {
  lang,
  title,
  description,
  type = 'website',
  alternateUrl,
  image,
  imageAlt,
  publishedTime,
  categoryLabel,
  tags = [],
} = Astro.props;
const siteTitle = SITE.title[lang];
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const pageDesc = description ?? SITE.description[lang];
const other = otherLang(lang);
const switchUrl = alternateUrl ?? `/${other}/`;
const path = Astro.url.pathname;
const t = UI[lang];
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
const alternateFullUrl = alternateUrl ? new URL(alternateUrl, SITE_URL).href : undefined;
// 대표 이미지가 없는 페이지/글도 공유 시 뉴로니 기본 배너(1200x630)가 보이도록 기본값 설정
const effectiveImage = image && image.trim() !== '' ? image : '/images/posts/meet-neuroni-cover.png';
const effectiveImageAlt =
  image && image.trim() !== '' ? imageAlt : lang === 'ko' ? 'Vibe Lab Notes 마스코트 뉴로니' : 'Vibe Lab Notes mascot Neuroni';
const ogImage = new URL(effectiveImage, Astro.site ?? SITE_URL).href;

const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title ?? siteTitle,
        description: pageDesc,
        image: [ogImage],
        datePublished: publishedTime?.toISOString(),
        inLanguage: lang === 'ko' ? 'ko-KR' : 'en-US',
        url: canonicalUrl,
        ...(categoryLabel ? { articleSection: categoryLabel } : {}),
        ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
        author: {
          '@type': 'Person',
          name: siteTitle,
          url: `${SITE_URL}/${lang}/about/`,
        },
        publisher: {
          '@type': 'Organization',
          name: siteTitle,
          logo: {
            '@type': 'ImageObject',
            url: new URL('/favicon.svg', SITE_URL).href,
          },
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteTitle,
        description: pageDesc,
        url: `${SITE_URL}/${lang}/`,
        inLanguage: lang === 'ko' ? 'ko-KR' : 'en-US',
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    {effectiveImageAlt && <meta property="og:image:alt" content={effectiveImageAlt} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && categoryLabel && <meta property="article:section" content={categoryLabel} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f6f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a24" media="(prefers-color-scheme: dark)" />
    {SITE_VERIFICATION.google && <meta name="google-site-verification" content={SITE_VERIFICATION.google} />}
    {SITE_VERIFICATION.naver && <meta name="naver-site-verification" content={SITE_VERIFICATION.naver} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    {alternateFullUrl && <link rel="alternate" hreflang={other} href={alternateFullUrl} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteTitle} (RSS)`} href={`/${lang}/rss.xml`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Serif+KR:wght@600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'ko' ? '본문 바로가기' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={`/${lang}/`}>
          <Logo size={30} />
          <span class="brand-name">{siteTitle}</span>
        </a>
        <nav class="site-nav">
          {
            CATEGORIES.map((cat) => {
              const href = `/${lang}/${cat}/`;
              return (
                <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                  {CATEGORY_LABEL[lang][cat]}
                </a>
              );
            })
          }
          <a href={`/${lang}/about/`} aria-current={path.startsWith(`/${lang}/about`) ? 'page' : undefined}>
            {t.about}
          </a>
          <a class="lang-switch" href={switchUrl} hreflang={other}>{t.otherLang}</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <Logo size={18} />
        <span>© {new Date().getFullYear()} {siteTitle}</span>
        <a class="footer-rss" href={`/${lang}/subscribe/`}>RSS · {t.subscribe}</a>
      </div>
    </footer>
    <script is:inline>
      // 방문자 수 세기 (worker/index.js 의 /api/visit). 실패해도 페이지에는 영향이 없어요.
      try { navigator.sendBeacon('/api/visit'); } catch {}
    </script>
  </body>
</html>
